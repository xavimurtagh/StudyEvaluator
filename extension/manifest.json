{
  "manifest_version": 3,
  "name": "StudyEvaluator",
  "version": "0.1.0",
  "description": "Fact-check wellness and supplement claims against PubMed evidence without leaving the page.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "http://localhost:8001/*",
    "http://127.0.0.1:8001/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "StudyEvaluator",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.tiktok.com/*",
        "https://*.instagram.com/*",
        "https://*.reddit.com/*",
        "https://*.x.com/*",
        "https://*.twitter.com/*",
        "https://*.youtube.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["products.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
